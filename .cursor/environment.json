{
  // Cursor Cloud Agent environment (https://cursor.com/docs/cloud-agent/setup)
  // Runtime: npm via ghcr.io/prashamtrivedi/cursor-dev-setup:v1.0.0 (skills/commands baked in).
  // Secrets cannot live in this file — add names below in the Cursor dashboard Secrets tab.
  // BETTER_AUTH_SECRET, BETTER_AUTH_URL, OTP_DEV_ECHO, EMAIL_API_KEY
  "name": "pustak",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "install": "/opt/prasham-cursor/bin/materialize-cursor-harness.sh && (npm ci || npm install)",
  "start": "npm run dev",
  "ports": [
    {
      "name": "worker",
      "port": 8787
    }
  ]
}
